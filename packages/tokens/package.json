{
  "name": "@tessera-design/tokens",
  "version": "0.5.0",
  "description": "Design tokens for the Tessera design system: colors for light and dark, type, space, radius, shadow and motion.",
  "license": "MIT",
  "author": "Justin Wagner",
  "homepage": "https://jwag789.github.io/tessera/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwag789/tessera.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/jwag789/tessera/issues"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "dark-mode",
    "theming",
    "tessera"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json",
    "./themes/*": "./dist/themes/*"
  },
  "files": [
    "dist",
    "tokens.json",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
